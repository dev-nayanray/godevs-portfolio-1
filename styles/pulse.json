{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Pulse",
	"description": "PULSE — UX / Product Designer. Cool neutral system, Inter sans paired with mono annotations, teal accent, 6px radii, systematic product-grade aesthetic. For product designers, UX designers and case-study-driven portfolios.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#0F1115", "name": "Primary" },
				{ "slug": "secondary", "color": "#3F4451", "name": "Secondary" },
				{ "slug": "accent", "color": "#0D9488", "name": "Accent" },
				{ "slug": "accent-hover", "color": "#0A766C", "name": "Accent Hover" },
				{ "slug": "base", "color": "#FAFAF8", "name": "Base" },
				{ "slug": "surface", "color": "#FFFFFF", "name": "Surface" },
				{ "slug": "surface-muted", "color": "#F4F5F7", "name": "Surface Muted" },
				{ "slug": "surface-elevated", "color": "#FFFFFF", "name": "Surface Elevated" },
				{ "slug": "foreground", "color": "#0F1115", "name": "Foreground" },
				{ "slug": "muted", "color": "#6B7280", "name": "Muted" },
				{ "slug": "line", "color": "#E5E7EB", "name": "Line" },
				{ "slug": "success", "color": "#0D9488", "name": "Success" },
				{ "slug": "warning", "color": "#C2680A", "name": "Warning" },
				{ "slug": "error", "color": "#C23A1A", "name": "Error" },
				{ "slug": "contrast", "color": "#FAFAF8", "name": "Contrast" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "\"Inter\", \"SF Pro Display\", \"Segoe UI\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "\"Inter\", \"SF Pro Text\", \"Segoe UI\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "\"SF Mono\", \"JetBrains Mono\", \"Menlo\", \"Consolas\", monospace"
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "\"Newsreader\", \"Times New Roman\", \"Times\", serif"
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "size": "0.75rem", "name": "Caption" },
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "normal", "size": "1.0625rem", "name": "Body" },
				{
					"slug": "medium",
					"size": "1.1875rem",
					"name": "Large Body",
					"fluid": { "min": "1.0625rem", "max": "1.375rem" }
				},
				{
					"slug": "large",
					"size": "1.5rem",
					"name": "H3",
					"fluid": { "min": "1.25rem", "max": "1.75rem" }
				},
				{
					"slug": "x-large",
					"size": "2rem",
					"name": "H2",
					"fluid": { "min": "1.625rem", "max": "2.5rem" }
				},
				{
					"slug": "xx-large",
					"size": "3rem",
					"name": "H1",
					"fluid": { "min": "2.25rem", "max": "4rem" }
				},
				{
					"slug": "xxx-large",
					"size": "4.25rem",
					"name": "Display",
					"fluid": { "min": "2.75rem", "max": "6rem" }
				},
				{
					"slug": "huge",
					"size": "6rem",
					"name": "Display Hero",
					"fluid": { "min": "3.25rem", "max": "8rem" }
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "#FAFAF8",
			"text": "#0F1115"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "var:preset|spacing|60",
				"bottom": "0",
				"left": "var:preset|spacing|60"
			},
			"blockGap": "var:preset|spacing|60"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|normal",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "#0F1115" },
				"typography": { "textDecoration": "underline", "textUnderlineOffset": "3px" }
			},
			"heading": {
				"color": { "text": "#0F1115" },
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "600",
					"lineHeight": "1.08",
					"letterSpacing": "-0.025em",
					"textTransform": "none"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|huge",
					"lineHeight": "1.0",
					"letterSpacing": "-0.04em",
					"fontWeight": "600"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|xxx-large",
					"lineHeight": "1.05",
					"letterSpacing": "-0.03em",
					"fontWeight": "600"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|x-large",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em",
					"fontWeight": "600"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|medium",
					"letterSpacing": "0",
					"fontWeight": "600"
				}
			},
			"button": {
				"border": { "radius": "6px" },
				"color": {
					"background": "#0F1115",
					"text": "#FAFAF8"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontWeight": "500",
					"fontSize": "0.9375rem",
					"letterSpacing": "-0.005em"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"right": "1.5rem",
						"bottom": "0.85rem",
						"left": "1.5rem"
					}
				},
				":hover": {
					"color": { "background": "#0D9488" }
				},
				":focus": {
					"color": { "background": "#0D9488" },
					"outline": { "offset": "3px" }
				}
			},
			"caption": {
				"color": { "text": "#6B7280" },
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "0.75rem",
					"letterSpacing": "0.02em"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "700",
					"letterSpacing": "-0.04em",
					"fontSize": "1.1875rem"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "0.875rem",
					"fontWeight": "500",
					"letterSpacing": "-0.005em"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|huge",
					"lineHeight": "1.0",
					"letterSpacing": "-0.04em",
					"fontWeight": "600"
				}
			},
			"core/separator": {
				"color": { "text": "#E5E7EB" }
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|x-large",
					"lineHeight": "1.2",
					"letterSpacing": "-0.02em",
					"fontWeight": "500"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|xx-large",
					"lineHeight": "1.1",
					"letterSpacing": "-0.025em",
					"fontWeight": "500"
				}
			}
		}
	}
}
