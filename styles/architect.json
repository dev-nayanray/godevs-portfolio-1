{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Architect",
	"description": "ARCHITECT: Architecture & Interior Design Studio. Warm concrete base, charcoal ink, muted bronze accent, Inter at medium weights with strong uppercase metadata. Calm, precise, material-focused, editorial. For architecture studios and interior designers.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#1C1A17", "name": "Primary" },
				{ "slug": "secondary", "color": "#3A352E", "name": "Secondary" },
				{ "slug": "accent", "color": "#8A6B3F", "name": "Accent" },
				{ "slug": "accent-hover", "color": "#745735", "name": "Accent Hover" },
				{ "slug": "base", "color": "#F2EFE8", "name": "Base" },
				{ "slug": "surface", "color": "#FBF9F3", "name": "Surface" },
				{ "slug": "surface-muted", "color": "#E8E3D8", "name": "Surface Muted" },
				{ "slug": "surface-elevated", "color": "#FFFFFF", "name": "Surface Elevated" },
				{ "slug": "foreground", "color": "#1C1A17", "name": "Foreground" },
				{ "slug": "muted", "color": "#6E685D", "name": "Muted" },
				{ "slug": "line", "color": "#D8D2C4", "name": "Line" },
				{ "slug": "success", "color": "#5A7A3A", "name": "Success" },
				{ "slug": "warning", "color": "#A66A1F", "name": "Warning" },
				{ "slug": "error", "color": "#9A3220", "name": "Error" },
				{ "slug": "contrast", "color": "#F2EFE8", "name": "Contrast" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "\"Inter\", \"SF Pro Display\", \"Segoe UI\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "\"Inter\", \"SF Pro Text\", \"Segoe UI\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "\"SF Mono\", \"JetBrains Mono\", \"Menlo\", \"Consolas\", monospace"
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "\"Newsreader\", \"Times New Roman\", \"Times\", serif"
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "size": "0.6875rem", "name": "Caption" },
				{ "slug": "small", "size": "0.8125rem", "name": "Small" },
				{ "slug": "normal", "size": "1rem", "name": "Body" },
				{
					"slug": "medium",
					"size": "1.1875rem",
					"name": "Large Body",
					"fluid": { "min": "1.0625rem", "max": "1.375rem" }
				},
				{
					"slug": "large",
					"size": "1.5rem",
					"name": "H3",
					"fluid": { "min": "1.25rem", "max": "1.75rem" }
				},
				{
					"slug": "x-large",
					"size": "2rem",
					"name": "H2",
					"fluid": { "min": "1.625rem", "max": "2.5rem" }
				},
				{
					"slug": "xx-large",
					"size": "3rem",
					"name": "H1",
					"fluid": { "min": "2.25rem", "max": "4.25rem" }
				},
				{
					"slug": "xxx-large",
					"size": "4.5rem",
					"name": "Display",
					"fluid": { "min": "2.75rem", "max": "6.5rem" }
				},
				{
					"slug": "huge",
					"size": "6.5rem",
					"name": "Display Hero",
					"fluid": { "min": "3.25rem", "max":  "9rem" }
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "#F2EFE8",
			"text": "#1C1A17"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "var:preset|spacing|60",
				"bottom": "0",
				"left": "var:preset|spacing|60"
			},
			"blockGap": "var:preset|spacing|60"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|normal",
			"lineHeight": "1.7",
			"fontWeight": "400"
		},
		"elements": {
			"link": {
				"color": { "text": "#1C1A17" },
				"typography": { "textDecoration": "underline", "textUnderlineOffset": "3px" }
			},
			"heading": {
				"color": { "text": "#1C1A17" },
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "500",
					"lineHeight": "1.08",
					"letterSpacing": "-0.02em",
					"textTransform": "none"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|huge",
					"lineHeight": "1.0",
					"letterSpacing": "-0.03em",
					"fontWeight": "500"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|xxx-large",
					"lineHeight": "1.04",
					"letterSpacing": "-0.025em",
					"fontWeight": "500"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|x-large",
					"lineHeight": "1.12",
					"letterSpacing": "-0.015em",
					"fontWeight": "500"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600",
					"letterSpacing": "0.2em",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"border": { "radius": "0" },
				"color": {
					"background": "#1C1A17",
					"text": "#F2EFE8"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontWeight": "500",
					"fontSize": "0.75rem",
					"letterSpacing": "0.18em",
					"textTransform": "uppercase"
				},
				"spacing": {
					"padding": {
						"top": "0.95rem",
						"right": "1.6rem",
						"bottom": "0.95rem",
						"left": "1.6rem"
					}
				},
				":hover": {
					"color": { "background": "#8A6B3F" }
				},
				":focus": {
					"color": { "background": "#8A6B3F" },
					"outline": { "offset": "3px" }
				}
			},
			"caption": {
				"color": { "text": "#8A8278" },
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "0.6875rem",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase",
					"fontWeight": "500"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "600",
					"letterSpacing": "0.22em",
					"fontSize": "0.875rem",
					"textTransform": "uppercase"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "0.75rem",
					"fontWeight": "500",
					"letterSpacing": "0.16em",
					"textTransform": "uppercase"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|huge",
					"lineHeight": "1.0",
					"letterSpacing": "-0.03em",
					"fontWeight": "500"
				}
			},
			"core/separator": {
				"color": { "text": "#D8D2C4" }
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|x-large",
					"lineHeight": "1.2",
					"letterSpacing": "-0.015em",
					"fontWeight": "400"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|xx-large",
					"lineHeight": "1.1",
					"letterSpacing": "-0.02em",
					"fontWeight": "400"
				}
			}
		}
	}
}
