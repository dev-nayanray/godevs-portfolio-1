{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Horizon",
	"description": "HORIZON — Travel Photographer / Visual Storyteller. Warm charcoal and ivory, burnt orange accent, Inter display + mono for coordinates/metadata. Immersive, cinematic, editorial, adventurous, premium travel photography.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#161310", "name": "Primary" },
				{ "slug": "secondary", "color": "#3A3530", "name": "Secondary" },
				{ "slug": "accent", "color": "#C25A2C", "name": "Accent" },
				{ "slug": "accent-hover", "color": "#A84A22", "name": "Accent Hover" },
				{ "slug": "base", "color": "#F5F2EB", "name": "Base" },
				{ "slug": "surface", "color": "#FBF9F3", "name": "Surface" },
				{ "slug": "surface-muted", "color": "#EDE8DD", "name": "Surface Muted" },
				{ "slug": "surface-elevated", "color": "#FFFFFF", "name": "Surface Elevated" },
				{ "slug": "foreground", "color": "#161310", "name": "Foreground" },
				{ "slug": "muted", "color": "#6E685D", "name": "Muted" },
				{ "slug": "line", "color": "#DDD6C8", "name": "Line" },
				{ "slug": "success", "color": "#5A7A3A", "name": "Success" },
				{ "slug": "warning", "color": "#C2862E", "name": "Warning" },
				{ "slug": "error", "color": "#9A3220", "name": "Error" },
				{ "slug": "contrast", "color": "#F5F2EB", "name": "Contrast" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "\"Inter\", \"SF Pro Display\", \"Segoe UI\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "\"Inter\", \"SF Pro Text\", \"Segoe UI\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "\"SF Mono\", \"JetBrains Mono\", \"Menlo\", \"Consolas\", monospace"
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "\"Newsreader\", \"Times New Roman\", \"Times\", serif"
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "size": "0.6875rem", "name": "Caption" },
				{ "slug": "small", "size": "0.8125rem", "name": "Small" },
				{ "slug": "normal", "size": "1.0625rem", "name": "Body" },
				{
					"slug": "medium",
					"size": "1.1875rem",
					"name": "Large Body",
					"fluid": { "min": "1.0625rem", "max": "1.375rem" }
				},
				{
					"slug": "large",
					"size": "1.5rem",
					"name": "H3",
					"fluid": { "min": "1.25rem", "max": "1.875rem" }
				},
				{
					"slug": "x-large",
					"size": "2.125rem",
					"name": "H2",
					"fluid": { "min": "1.75rem", "max": "2.625rem" }
				},
				{
					"slug": "xx-large",
					"size": "3.25rem",
					"name": "H1",
					"fluid": { "min": "2.375rem", "max": "4.5rem" }
				},
				{
					"slug": "xxx-large",
					"size": "5rem",
					"name": "Display",
					"fluid": { "min": "3rem", "max": "7rem" }
				},
				{
					"slug": "huge",
					"size": "7.5rem",
					"name": "Display Hero",
					"fluid": { "min": "3.75rem", "max": "10rem" }
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "#F5F2EB",
			"text": "#161310"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "var:preset|spacing|60",
				"bottom": "0",
				"left": "var:preset|spacing|60"
			},
			"blockGap": "var:preset|spacing|60"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|normal",
			"lineHeight": "1.7",
			"fontWeight": "400"
		},
		"elements": {
			"link": {
				"color": { "text": "#161310" },
				"typography": { "textDecoration": "underline", "textUnderlineOffset": "3px" }
			},
			"heading": {
				"color": { "text": "#161310" },
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "600",
					"lineHeight": "1.05",
					"letterSpacing": "-0.03em",
					"textTransform": "none"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|huge",
					"lineHeight": "0.98",
					"letterSpacing": "-0.04em",
					"fontWeight": "600"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|xxx-large",
					"lineHeight": "1.0",
					"letterSpacing": "-0.035em",
					"fontWeight": "600"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|x-large",
					"lineHeight": "1.1",
					"letterSpacing": "-0.02em",
					"fontWeight": "600"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"border": { "radius": "0" },
				"color": {
					"background": "#161310",
					"text": "#F5F2EB"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontWeight": "500",
					"fontSize": "0.6875rem",
					"letterSpacing": "0.18em",
					"textTransform": "uppercase"
				},
				"spacing": {
					"padding": {
						"top": "0.95rem",
						"right": "1.6rem",
						"bottom": "0.95rem",
						"left": "1.6rem"
					}
				},
				":hover": {
					"color": { "background": "#C25A2C" }
				},
				":focus": {
					"color": { "background": "#C25A2C" },
					"outline": { "offset": "3px" }
				}
			},
			"caption": {
				"color": { "text": "#8A8278" },
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "0.6875rem",
					"letterSpacing": "0.04em"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "700",
					"letterSpacing": "-0.04em",
					"fontSize": "1.1875rem"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "0.75rem",
					"fontWeight": "500",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|huge",
					"lineHeight": "0.98",
					"letterSpacing": "-0.04em",
					"fontWeight": "600"
				}
			},
			"core/separator": {
				"color": { "text": "#DDD6C8" }
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|x-large",
					"lineHeight": "1.2",
					"letterSpacing": "-0.02em",
					"fontWeight": "500"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|xx-large",
					"lineHeight": "1.1",
					"letterSpacing": "-0.025em",
					"fontWeight": "500"
				}
			}
		}
	}
}
