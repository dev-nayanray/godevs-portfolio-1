{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Atelier",
	"description": "ATELIER: Independent Creative Designer & Art Director. Editorial serif display on warm ivory paper, deep charcoal ink, restrained clay accent. Generous whitespace, asymmetric editorial composition, gallery-grade restraint. For art directors, brand designers and visual artists.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#1A1814", "name": "Primary" },
				{ "slug": "secondary", "color": "#3A352E", "name": "Secondary" },
				{ "slug": "accent", "color": "#A04A2A", "name": "Accent" },
				{ "slug": "accent-hover", "color": "#8A3D22", "name": "Accent Hover" },
				{ "slug": "base", "color": "#F7F4ED", "name": "Base" },
				{ "slug": "surface", "color": "#FBF9F3", "name": "Surface" },
				{ "slug": "surface-muted", "color": "#EFEAE0", "name": "Surface Muted" },
				{ "slug": "surface-elevated", "color": "#FFFEF8", "name": "Surface Elevated" },
				{ "slug": "foreground", "color": "#1A1814", "name": "Foreground" },
				{ "slug": "muted", "color": "#6E685D", "name": "Muted" },
				{ "slug": "line", "color": "#E0D9CC", "name": "Line" },
				{ "slug": "success", "color": "#4A6B3E", "name": "Success" },
				{ "slug": "warning", "color": "#A66A1F", "name": "Warning" },
				{ "slug": "error", "color": "#9A3220", "name": "Error" },
				{ "slug": "contrast", "color": "#F7F4ED", "name": "Contrast" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "\"Newsreader\", \"Times New Roman\", \"Times\", serif"
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "\"Inter\", \"SF Pro Text\", \"Segoe UI\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "\"SF Mono\", \"JetBrains Mono\", \"Menlo\", \"Consolas\", monospace"
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "\"Newsreader\", \"Times New Roman\", \"Times\", serif"
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "size": "0.75rem", "name": "Caption" },
				{ "slug": "small", "size": "0.8125rem", "name": "Small" },
				{ "slug": "normal", "size": "1.0625rem", "name": "Body" },
				{
					"slug": "medium",
					"size": "1.25rem",
					"name": "Large Body",
					"fluid": { "min": "1.0625rem", "max": "1.375rem" }
				},
				{
					"slug": "large",
					"size": "1.625rem",
					"name": "H3",
					"fluid": { "min": "1.375rem", "max": "1.875rem" }
				},
				{
					"slug": "x-large",
					"size": "2.25rem",
					"name": "H2",
					"fluid": { "min": "1.75rem", "max": "2.75rem" }
				},
				{
					"slug": "xx-large",
					"size": "3.25rem",
					"name": "H1",
					"fluid": { "min": "2.25rem", "max": "4.25rem" }
				},
				{
					"slug": "xxx-large",
					"size": "4.5rem",
					"name": "Display",
					"fluid": { "min": "2.75rem", "max": "6rem" }
				},
				{
					"slug": "huge",
					"size": "6.5rem",
					"name": "Display Hero",
					"fluid": { "min": "3.25rem", "max": "8.5rem" }
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "#F7F4ED",
			"text": "#1A1814"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "var:preset|spacing|60",
				"bottom": "0",
				"left": "var:preset|spacing|60"
			},
			"blockGap": "var:preset|spacing|60"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|normal",
			"lineHeight": "1.75"
		},
		"elements": {
			"link": {
				"color": { "text": "#1A1814" },
				"typography": { "textDecoration": "underline", "textUnderlineOffset": "4px", "textDecorationThickness": "1px" }
			},
			"heading": {
				"color": { "text": "#1A1814" },
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "400",
					"lineHeight": "1.08",
					"letterSpacing": "-0.015em",
					"textTransform": "none"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|huge",
					"lineHeight": "1.02",
					"letterSpacing": "-0.02em",
					"fontWeight": "400"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|xxx-large",
					"lineHeight": "1.05",
					"letterSpacing": "-0.015em",
					"fontWeight": "400"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|x-large",
					"lineHeight": "1.1",
					"letterSpacing": "-0.01em",
					"fontWeight": "400"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|medium",
					"letterSpacing": "0",
					"fontWeight": "600",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"border": { "radius": "0" },
				"color": {
					"background": "#1A1814",
					"text": "#F7F4ED"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontWeight": "500",
					"fontSize": "0.8125rem",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"right": "1.75rem",
						"bottom": "1rem",
						"left": "1.75rem"
					}
				},
				":hover": {
					"color": { "background": "#A04A2A" }
				},
				":focus": {
					"color": { "background": "#A04A2A" },
					"outline": { "offset": "3px" }
				}
			},
			"caption": {
				"color": { "text": "#8C8478" },
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "0.75rem",
					"letterSpacing": "0.04em",
					"fontStyle": "italic"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "400",
					"letterSpacing": "0.02em",
					"fontSize": "1.375rem",
					"fontStyle": "italic"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "0.8125rem",
					"fontWeight": "400",
					"letterSpacing": "0.02em"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|huge",
					"lineHeight": "1.02",
					"letterSpacing": "-0.02em",
					"fontWeight": "400"
				}
			},
			"core/separator": {
				"color": { "text": "#E0D9CC" }
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|xx-large",
					"lineHeight": "1.15",
					"letterSpacing": "-0.015em",
					"fontWeight": "400",
					"fontStyle": "normal"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|xxx-large",
					"lineHeight": "1.08",
					"letterSpacing": "-0.02em",
					"fontWeight": "400"
				}
			}
		}
	}
}
